# ──────────────────────────────────────────────────────────────
# RC SAR — environment example. Copy to `.env` and adjust.
# Never commit real secrets; `.env` is gitignored.
# ──────────────────────────────────────────────────────────────

# --- Database (data-api + Postgres) ---
POSTGRES_DB=search_rescue_db
POSTGRES_USER=sar_api
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://sar_api:change_me@db:5432/search_rescue_db

# --- Ports ---
API_PORT=8000           # data-api (host + container)
STATION_PORT=8000       # station port INSIDE its container
STATION_HOST_PORT=8001  # host port mapped to the station (avoids clashing with api)
FRONTEND_PORT=7860

# --- Station modes ---
# mock = no hardware/ML deps (laptop); real = Raspberry Pi; auto = real if available else mock.
DETECTION_MODE=mock
HARDWARE_MODE=mock
STATION_PROFILE=base    # base (light/mock) | full (torch + Pi hardware libs)
LOG_LEVEL=INFO

# --- Detection / model (real mode) ---
MODEL_PATH=/models/best.pt   # your trained YOLOv26 weights (mounted on the Pi)
MODEL_DIR=./backend/model/weights
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.45
# Empty = compose defaults (Pi: TARGET_FPS 6, IMG_SIZE 320). No inline comments: compose reads them as the value.
TARGET_FPS=
IMG_SIZE=

# --- Cameras (real mode) ---
# detection camera (telescopic pole), e.g. rtsp://user:pass@host:554/stream1
RTSP_CAMERA_1_URL=
# FPV / navigation camera
RTSP_CAMERA_2_URL=
USB_CAMERA_INDEX=0

# --- Frontend -> backends (service names inside Docker) ---
API_URL=http://api:8000
STATION_URL=http://station:8000
FRONTEND_HTTP_TIMEOUT=2.5
FRONTEND_BACKEND_COOLDOWN=5.0
FRONTEND_AUTO_START_DETECTION=false
# Seconds between live-view refreshes (min 0.05). Lower = smoother but uses more CPU.
FRONTEND_CAMERA_REFRESH_SECONDS=0.1

# --- Hardware pins (BCM) — defaults match backend/station/config.py (the source of truth) ---
# Override only if your wiring differs.
# BUZZER_PIN=5
# SYSTEM_LED_PIN=23
# DETECTION_LED_PIN=17
# DHT_PIN=25
# ADS1115_I2C_ADDR=0x4b
# LCD_I2C_ADDR=0x27
