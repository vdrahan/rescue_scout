# Copy to .env before: docker compose up -d
#   cp .env.example .env
#
# main.py loads this file via python-dotenv (Docker also passes it via compose env_file).
#
# Inside Docker Compose, the database host is the service name "postgres".
# From the Pi host (outside Compose), use 127.0.0.1 or the Pi LAN IP.

# PostgreSQL (used by the FastAPI container)
DATABASE_URL=postgresql://ctai:ctai@postgres:5432/projectone

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Postgres container (must match docker-compose.yml postgres service)
POSTGRES_USER=ctai
POSTGRES_PASSWORD=ctai
POSTGRES_DB=projectone

# pgAdmin web UI (must match docker-compose.yml pgadmin service)
PGADMIN_DEFAULT_EMAIL=student@howest.be
PGADMIN_DEFAULT_PASSWORD=ctai
